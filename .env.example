# ==========================================
# INFRASTRUCTURE & NETWORKING
# ==========================================
# The domain or IP address where the system is hosted.
# Leave as localhost for local development.
DOMAIN=localhost

# Ports for the Caddy reverse proxy to listen on
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
# Deployment enviroment for the Go backend. Set to production/development. Affects logging error handling
DEPLOYMENT_ENV=development

# ==========================================
# DATABASE SECRETS
# ==========================================
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>
# For Docker Compose, the host is usually 'database'
POSTGRES_USER=beacon_app
POSTGRES_PASSWORD=super_secure_password_here
POSTGRES_DB=beacon_db
POSTGRES_HOST=database

# ==========================================
# APPLICATION SECRETS
# ==========================================
JWT_MINT_SECRET=change_this_to_a_long_random_string
REFRESH_TOKEN_HASH_SECRET=change_this_to_another_long_random_string

# ==========================================
# EXTERNAL SERVICES
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_USERNAME=user@gmail.com
SMTP_PASSWORD=yoursupersecurepassword
